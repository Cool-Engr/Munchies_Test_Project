{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "dist",
    "baseUrl": "src",
    "paths": {
      "@middlewares": ["middlewares/index"],
      "@routes": ["routes/index"],
      "@types": ["types/index"],
      "@utils": ["utils/index"],
      "@config": ["config/index"],
      "@config/*": ["config/*"],
      "@controllers": ["controllers/index"]
    },

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Recommended Options
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
